# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Production values are set in Railway (ADR-005).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# host.docker.internal points to the Postgres container of sk8-infrastructure when
# the app itself runs in Docker. Override in .env.local (e.g. another port or 127.0.0.1).
DATABASE_URL="postgresql://sk8:sk8@host.docker.internal:5432/sk8_backend?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/security ###
# Static API key expected in the X-Api-Key header (ADR-006). Rotate in Railway, never commit a real one.
APP_API_KEY=dev-key-change-me
###< app/security ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> app/ai ###
# Model ids are verified against the provider documentation when the first AI feature lands (ADR-010).
# Without ANTHROPIC_API_KEY the AI endpoints answer 503; everything else works normally.
AI_MODEL_VISION=
AI_MODEL_TEXT=
ANTHROPIC_API_KEY=
###< app/ai ###
